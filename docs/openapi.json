{
  "openapi": "3.0.3",
  "paths": {
    "/v1/alarms": {
      "post": {
        "description": "생성만으로는 발송되지 않는다. 발송은 /send로 시작한다.",
        "operationId": "AlarmsController_create",
        "parameters": [],
