                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "수신자별 결과",
        "tags": [
          "alarms"
        ]
      }
    }
  },
  "info": {
    "title": "Alarm Dispatcher API",
    "description": "다수의 수신자에게 알림을 발송한다. 에러는 RFC 9457 Problem Details(application/problem+json)로 응답한다.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "고정 API 키 (ADR-0033)"
      }
    },
    "schemas": {
      "FieldErrorView": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ProblemView": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "/problems/invalid-state",
            "description": "에러 종류. 클라이언트는 이 값으로 분기한다"
          },
          "title": {
            "type": "string",
            "example": "Not allowed in the current state"
          },
          "status": {
            "type": "number",
            "example": 409
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "example": "/v1/alarms/0193.../send"
          },
          "traceId": {
            "type": "string",
            "description": "같은 값이 서버 로그에 남는다",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736"
          },
          "errors": {
            "description": "입력 검증 실패(400)일 때 필드별 오류",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorView"
            }
          },
          "currentStatus": {
            "type": "string",
            "description": "상태 충돌(409)일 때 현재 상태"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "traceId"
        ]
      },
      "CreateAlarmRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "BULK",
              "URGENT"
            ],
            "description": "필수이며 기본값이 없다. 빠뜨리기만 해도 전체 발송이 되는 사고를 막는다."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "알림을 구별하는 관리용 이름. 외부로 발송되지 않는다."
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "수신자에게 발송되는 본문"
          },
          "recipientIds": {
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "description": "URGENT 전용이며 필수다. BULK에 지정하면 거절한다.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "type",
          "title",
          "body"
        ]
      },
      "AlarmView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "BULK",
              "URGENT"
            ]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "SENDING",
              "CANCELING",
              "CANCELED",
              "COMPLETED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cancelReason": {
            "type": "string",
            "enum": [
              "REQUESTED",
              "EXPANSION_FAILED"
            ],
            "nullable": true,
            "description": "REQUESTED는 취소 요청, EXPANSION_FAILED는 수신자 조회가 다시 해도 안 되는 오류로 실패해 시스템이 멈춘 것이다"
          },
          "lastErrorCode": {
            "type": "string",
            "nullable": true,
            "description": "시스템이 멈춘 경우의 마지막 오류 코드"
          },
          "lastErrorMessage": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "body",
          "status",
          "createdAt",
          "startedAt",
          "finishedAt",
          "cancelReason",
          "lastErrorCode",
          "lastErrorMessage"
        ]
      },
      "AlarmListView": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlarmView"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "DeliveryCounts": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "pending": {
            "type": "number"
          },
          "inFlight": {
            "type": "number"
          },
          "unconfirmed": {
            "type": "number"
          },
          "sent": {
            "type": "number"
          },
          "failed": {
            "type": "number"
          },
          "canceled": {
            "type": "number"
          }
        },
        "required": [
          "total",
          "pending",
          "inFlight",
          "unconfirmed",
          "sent",
          "failed",
          "canceled"
        ]
      },
      "AlarmDetailView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "BULK",
              "URGENT"
            ]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "SENDING",
              "CANCELING",
              "CANCELED",
              "COMPLETED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cancelReason": {
            "type": "string",
            "enum": [
              "REQUESTED",
              "EXPANSION_FAILED"
            ],
            "nullable": true,
            "description": "REQUESTED는 취소 요청, EXPANSION_FAILED는 수신자 조회가 다시 해도 안 되는 오류로 실패해 시스템이 멈춘 것이다"
          },
          "lastErrorCode": {
            "type": "string",
            "nullable": true,
            "description": "시스템이 멈춘 경우의 마지막 오류 코드"
          },
          "lastErrorMessage": {
            "type": "string",
            "nullable": true
          },
          "recipientIds": {
            "description": "URGENT일 때 지정한 수신자",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counts": {
            "description": "조회 시점에 Delivery에서 센 값 (ADR-0018)",
            "allOf": [
              {
                "$ref": "#/components/schemas/DeliveryCounts"
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "body",
          "status",
          "createdAt",
          "startedAt",
          "finishedAt",
          "cancelReason",
          "lastErrorCode",
          "lastErrorMessage",
          "counts"
        ]
      },
      "DeliveryView": {
        "type": "object",
        "properties": {
          "recipientId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_FLIGHT",
              "UNCONFIRMED",
              "SENT",
              "FAILED",
              "CANCELED"
            ]
          },
          "attempts": {
            "type": "number"
          },
          "messageId": {
            "type": "string",
            "nullable": true
          },
          "sentAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastErrorCode": {
            "type": "string",
            "nullable": true
          },
          "lastErrorMessage": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "recipientId",
          "status",
          "attempts",
          "messageId",
          "sentAt",
          "lastErrorCode",
          "lastErrorMessage",
          "updatedAt"
        ]
      },
      "DeliveryListView": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeliveryView"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      }
    }
  }
