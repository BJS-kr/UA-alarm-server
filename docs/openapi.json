              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmView"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
