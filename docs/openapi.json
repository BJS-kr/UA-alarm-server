      }
    },
    "/v1/alarms/{id}/send": {
      "post": {
        "description": "CREATED → SENDING 전이. 이미 SENDING/CANCELING이면 202, COMPLETED면 200, CANCELED면 409를 반환한다 (ADR-0016, ADR-0020).",
        "operationId": "AlarmsController_send",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "이미 발송 완료된 알림",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmView"
                }
              }
            }
          },
          "202": {
            "description": "발송 시작 또는 진행 중",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmView"
                }
              }
            }
          },
          "400": {
            "description": "유효하지 않은 UUID 형식",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "404": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "409": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "500": {
            "description": "예기치 않은 서버 내부 오류 (내부 정보 노출 없이 traceId만 반환, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "503": {
            "description": "DB 연결 실패 또는 쿼리 타임아웃 (ADR-0039)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "알림 발송 시작",
        "tags": ["alarms"]
      }
    },
    "/v1/alarms/{id}/cancel": {
      "post": {
        "description": "CREATED → CANCELED(200), SENDING → CANCELING(202) 전이. 이미 완료된 알림(COMPLETED)은 409를 반환하며 기발송 건은 취소되지 않는다 (ADR-0017).",
        "operationId": "AlarmsController_cancel",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "취소 완료 (CANCELED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmView"
                }
              }
            }
          },
          "202": {
            "description": "발송 진행 중인 건의 정리 후 취소 진행 중 (CANCELING)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmView"
                }
              }
            }
          },
          "400": {
            "description": "유효하지 않은 UUID 형식",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "404": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "409": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "500": {
            "description": "예기치 않은 서버 내부 오류 (내부 정보 노출 없이 traceId만 반환, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "503": {
            "description": "DB 연결 실패 또는 쿼리 타임아웃 (ADR-0039)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "알림 발송 취소",
        "tags": ["alarms"]
      }
    },
    "/v1/alarms/{id}/deliveries": {
      "get": {
        "description": "수신자 ID 오름차순 커서 페이지네이션으로 발송 내역을 조회한다. status 필터를 지원한다.",
        "operationId": "AlarmsController_deliveries",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "IN_FLIGHT",
                "UNCONFIRMED",
                "SENT",
                "FAILED",
                "CANCELED"
              ]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "이전 응답의 nextCursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryListView"
                }
              }
            }
          },
          "400": {
            "description": "유효하지 않은 UUID 형식 또는 잘못된 쿼리/커서 파라미터",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "404": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "500": {
            "description": "예기치 않은 서버 내부 오류 (내부 정보 노출 없이 traceId만 반환, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "503": {
            "description": "DB 연결 실패 또는 쿼리 타임아웃 (ADR-0039)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "수신자별 발송 내역 조회",
        "tags": ["alarms"]
      }
    }
  },
  "info": {
    "title": "Alarm Dispatcher API",
    "description": "대량/긴급 알림 발송 API. 오류 응답은 RFC 9457 Problem Details(application/problem+json) 형식을 따른다.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Bearer API 키 인증 (ADR-0033)"
      }
    },
    "schemas": {
      "FieldErrorView": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["field", "message"]
      },
      "ProblemView": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "/problems/invalid-state",
            "enum": [
              "/problems/validation-failed",
              "/problems/bad-request",
              "/problems/unauthorized",
              "/problems/not-found",
              "/problems/method-not-allowed",
              "/problems/unsupported-media-type",
              "/problems/invalid-state",
              "/problems/internal-error",
              "/problems/service-unavailable"
            ],
            "description": "오류 유형 식별자 URI"
          },
          "title": {
            "type": "string",
            "example": "Not allowed in the current state"
          },
          "status": {
            "type": "number",
            "example": 409
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "example": "/v1/alarms/0193.../send"
          },
          "traceId": {
            "type": "string",
            "description": "요청 추적용 식별자 (서버 로그와 매핑)",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736"
          },
          "errors": {
            "description": "요청 검증 실패(400) 시 필드별 상세 오류 목록",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorView"
            }
          },
          "currentStatus": {
            "type": "string",
            "description": "상태 전이 충돌(409) 시 현재 리소스 상태"
          }
        },
        "required": ["type", "title", "status", "instance", "traceId"]
      },
      "CreateAlarmRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["BULK", "URGENT"],
            "description": "알림 발송 유형 (URGENT | BULK). 기본값 없이 필수로 지정한다."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "알림 식별용 관리 제목 (외부 발송 본문에 포함되지 않음)"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "수신자에게 발송되는 알림 본문"
          },
          "recipientIds": {
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "description": "URGENT 알림의 대상 수신자 ID 목록 (BULK 알림에서는 지정 불가)",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["type", "title", "body"]
      },
      "AlarmView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": ["BULK", "URGENT"]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["CREATED", "SENDING", "CANCELING", "CANCELED", "COMPLETED"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cancelReason": {
            "type": "string",
            "enum": ["REQUESTED", "EXPANSION_FAILED"],
            "nullable": true,
            "description": "취소 사유 (REQUESTED: 사용자 취소 요청, EXPANSION_FAILED: 수신자 목록 조회 영구 오류로 인한 중단)"
          },
          "lastErrorCode": {
            "type": "string",
            "nullable": true,
            "description": "비정상 중단 시 기록된 마지막 오류 코드"
          },
          "lastErrorMessage": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "body",
          "status",
          "createdAt",
          "startedAt",
          "finishedAt",
          "cancelReason",
          "lastErrorCode",
          "lastErrorMessage"
        ]
      },
      "AlarmListView": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlarmView"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["items", "nextCursor"]
      },
      "DeliveryCounts": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "pending": {
            "type": "number"
          },
          "inFlight": {
            "type": "number"
          },
          "unconfirmed": {
            "type": "number"
          },
          "sent": {
            "type": "number"
          },
          "failed": {
            "type": "number"
          },
          "canceled": {
            "type": "number"
          }
        },
