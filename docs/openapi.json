{
  "openapi": "3.0.3",
  "paths": {
    "/v1/alarms": {
      "post": {
        "description": "CREATED 상태의 알림을 생성한다. 실제 발송은 POST /v1/alarms/:id/send 호출 시 시작된다.",
        "operationId": "AlarmsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAlarmRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmView"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "413": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "500": {
            "description": "예기치 않은 서버 내부 오류 (내부 정보 노출 없이 traceId만 반환, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "503": {
            "description": "DB 연결 실패 또는 쿼리 타임아웃 (ADR-0039)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "알림 생성",
        "tags": ["alarms"]
      },
      "get": {
        "description": "최신순(UUIDv7 내림차순) 커서 페이지네이션으로 알림 목록을 조회한다 (ADR-0024). 상태별 Delivery 집계는 단건 조회에서 반환한다.",
        "operationId": "AlarmsController_list",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "CREATED",
                "SENDING",
                "CANCELING",
                "CANCELED",
                "COMPLETED"
              ]
            }
          },
          {
            "name": "type",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["BULK", "URGENT"]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "이전 응답의 nextCursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
