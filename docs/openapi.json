        ],
        "summary": "발송 취소",
        "tags": [
          "alarms"
        ]
      }
    },
    "/v1/alarms/{id}/deliveries": {
      "get": {
        "description": "수신자 ID 순, 커서 페이지네이션. 상태로 거를 수 있다.",
        "operationId": "AlarmsController_deliveries",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "IN_FLIGHT",
                "UNCONFIRMED",
                "SENT",
                "FAILED",
                "CANCELED"
              ]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "이전 응답의 nextCursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryListView"
                }
              }
            }
          },
          "400": {
            "description": "ID가 UUID가 아니거나 커서·쿼리가 틀림",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "401": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "404": {
            "description": "Problem Details (RFC 9457, ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "500": {
            "description": "예상하지 못한 오류. 내부 정보 없이 traceId만 준다 (ADR-0019)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemView"
                }
              }
            }
          },
          "503": {
            "description": "DB에 연결할 수 없거나 정해 둔 시간 안에 답이 없음. 잠시 뒤 다시 시도한다 (ADR-0039)",
            "content": {
              "application/problem+json": {
