                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "발송 시작",
        "tags": [
          "alarms"
        ]
      }
    },
    "/v1/alarms/{id}/cancel": {
      "post": {
        "description": "CREATED → CANCELED(200), SENDING → CANCELING(202). 완료된 알림은 409. 이미 나간 건은 되돌리지 않는다 (ADR-0017).",
        "operationId": "AlarmsController_cancel",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "취소가 끝남",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmView"
                }
              }
            }
          },
          "202": {
            "description": "이미 나가던 건을 정리하는 중",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmView"
                }
              }
            }
          },
          "400": {
            "description": "ID가 UUID가 아님",
            "content": {
              "application/problem+json": {
                "schema": {
