    "/v1/alarms/{id}/send": {
      "post": {
        "description": "CREATED → SENDING. 이미 SENDING이면 202, COMPLETED면 200, 취소된 알림이면 409 (ADR-0016, 0020).",
        "operationId": "AlarmsController_send",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "이미 완료됨",
            "content": {
